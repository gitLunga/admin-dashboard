# Copy to .env (git-ignored) for local development. Create React App only exposes REACT_APP_* variables.
REACT_APP_API_URL=http://localhost:5000/api

# Production builds must set the real API in the build environment (hosting provider settings / CI),
# NOT in a committed file, otherwise the bundle ships with the localhost address above:
# REACT_APP_API_URL=https://api.malcam.co.za/api
